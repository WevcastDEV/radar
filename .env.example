# ===================================
# Radar de Oportunidades - Variáveis de Ambiente
# ===================================

# Banco de Dados
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_secret_2024
POSTGRES_DB=radar_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://radar:radar_secret_2024@localhost:5432/radar_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=radar_redis_2024

# JWT
JWT_SECRET=radar-jwt-secret-change-in-production-2024
JWT_REFRESH_SECRET=radar-refresh-secret-change-in-production-2024
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# API
API_PORT=3001
API_URL=http://localhost:3001

# AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Front-end
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Radar de Oportunidades
NEXT_PUBLIC_MAP_DEFAULT_LAT=-23.5505
NEXT_PUBLIC_MAP_DEFAULT_LNG=-46.6333
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# Uploads / Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
